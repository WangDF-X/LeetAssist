{
  "name": "leetassist",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:theme && npm run check:dsl && vite build",
    "typecheck": "tsc --noEmit",
    "check:theme": "node scripts/check-theme.mjs",
    "check:dsl": "esbuild scripts/check-dsl-schema.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check-dsl.mjs && node node_modules/.cache/check-dsl.mjs",
    "test:dsl": "esbuild scripts/dsl-tests.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/dsl-tests.mjs && node node_modules/.cache/dsl-tests.mjs"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "konva": "^10.6.0",
    "lz-string": "^1.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.16",
    "simplify-js": "^1.2.4"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/chrome": "^0.0.287",
    "@types/lz-string": "^1.3.34",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
